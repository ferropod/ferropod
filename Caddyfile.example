{
    on_demand_tls {
        ask http://127.0.0.1:8080/_internal/tls/allow
    }
}

# Primary wildcard domain (recommended with DNS-01 challenge plugin if needed)
# *.app.example.com {
#     reverse_proxy 127.0.0.1:8080
# }

# Automatic HTTPS for verified custom domains and routed hosts
https:// {
    tls {
        on_demand
    }
    reverse_proxy 127.0.0.1:8080 {
        header_up X-Forwarded-Proto {scheme}
    }
}
